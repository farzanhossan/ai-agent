PORT=4001
APP_ENV=development
NODE_ENV=development
API_PREFIX=api/v1
TZ=UTC

# 
# Swagger
# 

API_VERSION=1.0.0
API_TITLE=Nest-Boilerplate
API_DESCRIPTION=Nest-Boilerplate

# 
# Default DB
# 


DB_TYPE=postgres
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=
DB_LOGGING=

# 
# Seed Data
# 
SEED_SUPER_ADMIN_EMAIL=superadmin@bp.com
SEED_SUPER_ADMIN_PASSWORD=123456

# 
# Security
# 

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# 
# Logger
# 

LOG_FOLDER=logs

# 
# JWT
# 

JWT_SECRET=bpkossc
JWT_SALT_ROUNDS=10
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# 
# BASE
# 

BASE_CUURENCY_CODE=USD
BASE_TIMEZONE=Asia/Dhaka

# 
# UPLOAD_BASE_PUBLIC_PATH
# 
UPLOAD_BASE_PUBLIC_PATH=https://bp-api-stg.techmatbd.com
DOWNLOAD_BASE_PUBLIC_PATH=https://bp-api-stg.techmatbd.com

# S3
S3_ENDPOINT=$S3_ENDPOINT
S3_ACCESS_KEY=$S3_ACCESS_KEY
S3_SECRET_KEY=$S3_SECRET_KEY
S3_BUCKET=$S3_BUCKET
S3_FOLDER_PREFIX=

# REDIS
REDIS_HOST=$REDIS_HOST
REDIS_PORT=$REDIS_PORT
REDIS_PASSWORD=$REDIS_PASSWORD