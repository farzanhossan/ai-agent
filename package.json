{
  "name": "checklist-builder-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "lint-prettier": "yarn prettier:fix && yarn lint:check",
    "husky-install": "husky install",
    "husky-prepare-pre-commit": "husky add .husky/pre-commit 'yarn lint-staged'",
    "db:seed": "ts-node dist/database/seeds/seed.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "yarn lint-prettier"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.772.0",
    "@langchain/core": "^1.0.1",
    "@langchain/ollama": "^1.0.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/typeorm": "^11.0.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/ip": "^1.1.3",
    "@types/request-promise": "^4.1.51",
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.1",
    "bullmq": "^5.44.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.0.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ip": "^2.0.1",
    "langchain": "^1.2.3",
    "nest-winston": "^1.8.0",
    "ollama": "^0.6.0",
    "otp-without-db": "^1.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.11",
    "utils-friendly": "^4.1.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/express-rate-limit": "^6.0.0",
    "@types/helmet": "^4.0.0",
    "@types/node": "^22.13.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.2.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec3000/docs/\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
